# ---- Backend .gitignore ----

# Dependency directories
node_modules/
package-lock.json
yarn.lock

# Environment files (secrets)
.env
.env.local
.env.*.local
.env.production
.env.example
.env.staging

# Data directory – contains products, orders, users, settings, transactions, etc.
# DO NOT commit this to version control; it's your production database.
data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.swo.*
*.swn

# Test coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
*.bak

# PM2 logs
.pm2/

# Optional – if you ever generate build artifacts
dist/
build/